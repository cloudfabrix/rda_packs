            "name": "widget_code_generator",
            "value": "{%- set ns = namespace(count=0) -%}\r\n{%- for section in dashboard[\"dashboard_sections\"] -%}\r\n    {%- set widgets = section[\"widgets\"] -%}\r\n    {%- set new_widgets = [] -%}\r\n    {%- for w in widgets -%}\r\n        {%- if w.get(\"widget_type\") and w.get(\"title\") != \"Asset Details\" -%}\r\n            {%-\r\n                set nw = {\r\n                    \"title\": \"JSON Dashboard Def.\",\r\n                    \"widget_group\": \"g\"+str(ns.count),\r\n                    \"min_width\": w.get(\"min_width\", 6),\r\n                    \"max_width\": w.get(\"max_width\", 6),\r\n                    \"height\": w.get(\"height\", 4),\r\n                    \"widget_type\": \"codeblock\",\r\n                    \"content\": json_dumps_indent(w, 2),\r\n                    \"lang\": \"json\",\r\n                    \"widget_id\": w.get(\"widget_id\", str(ns.count)) + \"_code\"\r\n                }\r\n            -%}\r\n            {%- set _ = w.update({\"widget_group\": \"g\"+str(ns.count) }) -%}\r\n            {%- set _ = new_widgets.append(nw) -%}\r\n            {%- set ns.count = ns.count + 1 -%}\r\n        {%- endif -%}\r\n    {%- endfor -%}\r\n    {%- set _ = widgets.extend(new_widgets) -%}\r\n{%- endfor -%}",
            "additionalFields": {
                "valueType": "",
                "description": ""
            }
        }
